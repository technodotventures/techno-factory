# Copy to .env only for local development. Never commit real credentials.
FACTORY_DATABASE_PATH=./data/factory.db
FACTORY_HOST=127.0.0.1
FACTORY_PORT=3000
FACTORY_CLIENTS_JSON='[{"keyId":"board-local","secret":"replace-with-at-least-32-random-bytes","grant":{"clientId":"board-local","organizationId":"your-organization","workspaceId":"your-workspace","projectIds":["your-project"],"permissions":["work:submit","work:read"]}}]'

# Board adapter (Coffee reference implementation — see docs/coffee-integration.md)
# COFFEE_WORKSPACE=your-workspace
# COFFEE_CHANNEL_HASH=your-channel-hash
# COFFEE_TOKEN_STORE=<path-to-token-store>
# FACTORY_APPROVER_USER_HASHES=<comma-separated-approver-ids>
# FACTORY_BOARD_WORKSPACE=your-workspace
# FACTORY_DELIVERY_REPO=your-org/your-repo
